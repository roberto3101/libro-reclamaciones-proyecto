# =============================================================================
# LIBRO DE RECLAMACIONES - Variables de entorno
# Copiar a .env y ajustar valores
# =============================================================================

# --- Servidor ---
SERVER_PORT=8080
SERVER_ENV=development

# --- CockroachDB ---
CRDB_HOST=localhost
CRDB_PORT=26257
CRDB_USER=root
CRDB_PASSWORD=
CRDB_DATABASE=libroreclamaciones
CRDB_SSLMODE=disable
CRDB_MAX_OPEN_CONNS=25
CRDB_MAX_IDLE_CONNS=10
CRDB_CONN_MAX_LIFETIME_MIN=30

# --- JWT ---
JWT_SECRET=cambiar-en-produccion-usar-minimo-32-caracteres
JWT_EXPIRATION_HOURS=24

# --- API Keys ---
API_KEY_PREFIX=crb

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MIN=60
RATE_LIMIT_REQUESTS_PER_DAY=5000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Culqi (pasarela de pagos, Perú) ---
# Sácalas en https://culqi.com > Desarrollo > API Keys
# Empieza con las de prueba (pk_test_ / sk_test_) antes de pasar a live.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=
CULQI_API_URL=https://api.culqi.com/v2
