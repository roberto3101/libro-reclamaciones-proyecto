# ─────────────────────────────────────────────────────────────────────
# Plantilla de configuración para producción.
#
#   cp .env.produccion.ejemplo .env
#
# Este archivo SÍ va al repositorio (no lleva valores). El .env que salga
# de él NO: contiene secretos. Comprueba que .env está en .gitignore.
#
# Lo mínimo para arrancar y cobrar:
#   JWT_SECRET, CRDB_PASSWORD, CULQI_*
# Ver DESPLIEGUE.md para el resto.
# ─────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# PRODUCCION — todos los valores sensibles van VACIOS a proposito.
# Rellena con tus datos antes de desplegar.
# ─────────────────────────────────────────────────────────────

# --- Servidor ---
SERVER_PORT=8060
SERVER_ENV=production

# --- CockroachDB ---
# Apunta a la instalacion LOCAL. Antes aqui figuraba el servidor y la base
# del sistema del que salio esta copia: arrancar con aquello habria hecho
# que esta copia escribiera en la base de produccion de ese sistema.
#
# Cuando tengas tu propio servidor, cambia HOST, USER, PASSWORD y pon
# SSLMODE=require (con `disable` la conexion viaja en claro; en una red
# local da igual, saliendo a internet no).
CRDB_HOST=
CRDB_PORT=26257
CRDB_USER=root
CRDB_PASSWORD=
CRDB_DATABASE=libroreclamaciones
CRDB_SSLMODE=disable
CRDB_MAX_OPEN_CONNS=25
CRDB_MAX_IDLE_CONNS=10
CRDB_CONN_MAX_LIFETIME_MIN=30

# --- JWT ---
JWT_SECRET=
JWT_EXPIRATION_HOURS=24

# --- API Keys ---
API_KEY_PREFIX=crb

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MIN=60
RATE_LIMIT_REQUESTS_PER_DAY=5000

# --- CORS ---
# Origenes LOCALES mientras no haya dominio. Al desplegar, sustituye esta
# linea por tus dominios (https://...), separados por coma. Si no coincide
# exactamente con el origen del navegador, el navegador bloquea la llamada
# y la app parece caida aunque el backend responda.
CORS_ALLOWED_ORIGINS=

# --- SMTP / Correo ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Asistente IA (principal: Groq) ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Fallback automático si Groq falla (SambaNova, 200K tokens/día gratis) ---
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=

# --- Proveedores extras (cadena de fallback extendida) ---
AI_EXTRA_1_ID=
AI_EXTRA_1_PROVIDER=
AI_EXTRA_1_API_KEY=
AI_EXTRA_1_MODEL=
AI_EXTRA_1_BASE_URL=

AI_EXTRA_2_ID=
AI_EXTRA_2_PROVIDER=
AI_EXTRA_2_API_KEY=
AI_EXTRA_2_MODEL=
AI_EXTRA_2_BASE_URL=

AI_EXTRA_3_ID=
AI_EXTRA_3_PROVIDER=
AI_EXTRA_3_API_KEY=
AI_EXTRA_3_MODEL=
AI_EXTRA_3_BASE_URL=

AI_EXTRA_4_ID=
AI_EXTRA_4_PROVIDER=
AI_EXTRA_4_API_KEY=
AI_EXTRA_4_MODEL=
AI_EXTRA_4_BASE_URL=

AI_EXTRA_5_ID=
AI_EXTRA_5_PROVIDER=
AI_EXTRA_5_API_KEY=
AI_EXTRA_5_MODEL=
AI_EXTRA_5_BASE_URL=

AI_EXTRA_6_ID=
AI_EXTRA_6_PROVIDER=
AI_EXTRA_6_API_KEY=
AI_EXTRA_6_MODEL=
AI_EXTRA_6_BASE_URL=

AI_EXTRA_7_ID=
AI_EXTRA_7_PROVIDER=
AI_EXTRA_7_API_KEY=
AI_EXTRA_7_MODEL=
AI_EXTRA_7_BASE_URL=

# --- Cloudflare Turnstile (CAPTCHA) ---
# La clave que habia aqui pertenecia al sistema original. Las claves de
# Turnstile van atadas al dominio que las registro, asi que en otro host no
# habria validado nada igualmente.
#
# Queda desactivado: con ENABLED=true y la clave vacia, el backend rechaza
# cada envio del libro publico. Cuando registres tu dominio en Cloudflare,
# pega aqui tu clave secreta y pon ENABLED=true.
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

# --- WhatsApp Business API ---
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# --- SQL Server (Validacion empresas - servidor 195) ---
SQLSERVER_HOST=
SQLSERVER_PORT=
SQLSERVER_USER=
SQLSERVER_PASS=
SQLSERVER_DB=

# --- Cloudflare R2 Storage Microservice ---
STORAGE_API_URL=
STORAGE_API_KEY=
# --- Culqi (cobros) ---
# Sin esto no se puede monetizar. El codigo ya esta escrito.
CULQI_API_URL=https://api.culqi.com/v2
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=

# --- MercadoPago ---
# Cliente escrito pero NO conectado al servicio de pagos todavia.
MP_API_URL=https://api.mercadopago.com
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
