---
import cap from '../data/capacidades.json';
---
<section id="capacidades" class="seccion" data-rv-grupo>
  <div class="shell">
    <div class="rejilla cap-cab">
      <div class="rail rv"><p class="et">Qué incluye</p></div>
      <div class="cuerpo rv">
        <h2 class="t-seccion">{cap.titulo}</h2>
        <p class="entrada cap-e">{cap.entrada}</p>
      </div>
    </div>

    <div class="grupos">
      {cap.grupos.map((g) => (
        <section class="grupo rv">
          <h3 class="grupo-t mono">{g.nombre}</h3>
          <ul class="items">
            {g.items.map((i) => (
              <li>
                <h4 class="item-t">{i.titulo}</h4>
                <p class="item-p">{i.texto}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .cap-cab { align-items: baseline; }
  .cap-e { margin-top: 14px; }

  .grupos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3vw, 52px);
    margin-top: clamp(38px, 4.6vw, 64px);
  }
  .grupo-t {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--carmine);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule-2);
  }
  .items li { padding: 18px 0; border-bottom: 1px solid var(--rule); }
  .item-t { font-family: var(--f-body); font-size: 15.5px; font-weight: 600; margin-bottom: 4px; }
  .item-p { font-size: 14.5px; color: var(--ink-2); }

  @media (max-width: 900px) { .grupos { grid-template-columns: 1fr; } }
</style>
