---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Norma from '../components/Norma.astro';
import Flujo from '../components/Flujo.astro';
import Capacidades from '../components/Capacidades.astro';
import Planes from '../components/Planes.astro';
import Preguntas from '../components/Preguntas.astro';
import Cierre from '../components/Cierre.astro';
import Pie from '../components/Pie.astro';
---

<Base ruta="/">
  <Nav />
  <main>
    <Hero />
    <Norma />
    <Flujo />
    <Capacidades />
    <Planes />
    <Preguntas />
    <Cierre />
  </main>
  <Pie />
</Base>
